{
  "name": "lamp-protocol",
  "version": "1.0.0",
  "private": true,
  "description": "The LAMP Protocol OpenAPI document and its validation tests.",
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true redocly lint openapi.yml",
