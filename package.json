    "test": "npm run lint && npm run test:schemas"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  }
}
